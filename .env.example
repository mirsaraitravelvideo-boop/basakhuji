# ============================================================
# বাসাখুঁজি বাংলাদেশ — Environment variables
# ============================================================
# মানগুলো নিন: Supabase ড্যাশবোর্ড → Project Settings → API Keys
#
# নতুন কী ফরম্যাট:
#   publishable key = sb_publishable_...  → ব্রাউজার/ক্লায়েন্টে ব্যবহারযোগ্য (anon key-এর বদলে)
#   secret key      = sb_secret_...       → শুধু সার্ভারে (service_role key-এর বদলে)
# পুরনো কী ফরম্যাট ("Legacy API keys" ট্যাবে):
#   anon key         → publishable key-এর বদলে ব্যবহার করা যায়
#   service_role key → secret key-এর বদলে ব্যবহার করা যায়
# দুটো ফরম্যাটই কাজ করে — ড্যাশবোর্ডে যেটা দেখা যায় সেটাই বসান।

# --- পাবলিক (ব্রাউজারেও যায়; Next.js-এ NEXT_PUBLIC_ prefix বাধ্যতামূলক) ---
# নতুন: sb_publishable_...  |  পুরনো: anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- সিক্রেট (শুধু সার্ভার-সাইড; কখনোই NEXT_PUBLIC_ দেবেন না,
# --- কখনোই ফ্রন্টএন্ড কোডে/গিটে কমিট করবেন না) ---
# নতুন: sb_secret_...  |  পুরনো: service_role key
# বর্তমান অ্যাপে এটি বাধ্যতামূলক নয় — সব অ্যাক্সেস RLS নীতি ও
# নিরাপদ RPC ফাংশন দিয়ে হয়। ভবিষ্যতে সার্ভার-সাইড অ্যাডমিন কাজে
# লাগবে (দেখুন: src/lib/supabase/admin.ts)।
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # পুরনো ফরম্যাট ব্যবহার করলে উপরের লাইনের বদলে এটি বসান

# সাইটের আসল ঠিকানা (sitemap-এর জন্য; ডেপ্লয়ের পর বসান)
# যেমন: NEXT_PUBLIC_SITE_URL=https://basakhuji.pages.dev
NEXT_PUBLIC_SITE_URL=
